# Copy to .env.development, .env.staging, or .env.production on each machine.
# Never commit filled secret files.

# Commerce database used by Prisma and Fastify.
DATABASE_URL=postgresql://abang:abang@localhost:5432/abang_commerce

# Strapi database. Same PostgreSQL server, separate database.
CMS_DATABASE_URL=postgresql://abang:abang@localhost:5432/abang_cms

API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000

# At least 32 characters. Used by the Fastify session cookie.
SESSION_SECRET=replace-with-a-random-string-of-32-plus-chars

TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=abang-products

RESEND_API_KEY=
RESEND_FROM=Abang AI Hub <receipts@example.com>

STRAPI_URL=http://localhost:1337
STRAPI_READ_TOKEN=

POSTHOG_KEY=
